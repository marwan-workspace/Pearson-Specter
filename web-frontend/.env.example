# Backend connection for the manager agent (Gemini).
# Copy to .env.local to change anything. With no settings at all, the dashboard runs
# `python -m overview <command>` in the repo root (one folder up) and reads GEMINI_API_KEY
# from the repo's own .env file. The code that uses these lives in src/server/agent-bridge.ts.

# Option A, Python bridge (default). Only set these if the defaults do not fit.
# AGENT_BACKEND_DIR=..            # folder that holds overview/ and llm.py
# AGENT_PYTHON=python             # Python to run; the repo's .venv is used automatically if it exists

# Option B, HTTP backend. When set, requests go to POST {url}/<assess|checkin|chat|weekly|emergency>
# and GET {url}/health instead of starting Python.
# AGENT_BACKEND_URL=http://localhost:8000

# AGENT_TIMEOUT_MS=60000          # how long to wait for one agent reply
# AGENT_MODE=off                  # force the local simulation
