---
references:
  - "File: /database/schema.sql"
---
erDiagram
    MISSIONS {
        uuid id PK
        string name
        string destination
        float earth_round_trip_seconds
        boolean earth_link_available
        int earth_review_seconds
        string status
    }
    ASTRONAUTS {
        uuid id PK
        uuid mission_id FK
        string callsign
        string display_name
        int command_rank
        boolean fit_for_command
        boolean active
    }
    ACCOUNTS {
        uuid id PK
        uuid astronaut_id FK
        string login UK
        string pin_hash
        int failed_attempts
        boolean locked
    }
    SESSIONS {
        uuid id PK
        uuid astronaut_id FK
        string token_hash UK
        timestamptz expires_at
    }
    COMMAND_HANDOVERS {
        uuid id PK
        uuid mission_id FK
        uuid from_astronaut_id FK
        uuid to_astronaut_id FK
        uuid decision_id FK
        string trigger
        string reason
    }
    RULE_SETS {
        uuid id PK
        uuid mission_id FK
        string name
        string version
        string status
    }
    RULES {
        uuid id PK
        uuid rule_set_id FK
        string condition_key
        int response_tier
        jsonb criteria
        jsonb response
        boolean enabled
    }
    VITAL_SAMPLES {
        uuid id PK
        uuid astronaut_id FK
        timestamptz observed_at
        float heart_rate_bpm
        float systolic_mmhg
        float diastolic_mmhg
        float spo2_percent
        float radiation_rate
        string sensor_status
        jsonb payload
    }
    SLEEP_SESSIONS {
        uuid id PK
        uuid astronaut_id FK
        timestamptz started_at
        timestamptz ended_at
        float reported_hours
        float quality_score
    }
    CHECK_INS {
        uuid id PK
        uuid astronaut_id FK
        date check_in_date
        string status
        float mental_health_score
        string agent_summary
        jsonb transcript
    }
    CHECK_IN_ANSWERS {
        uuid id PK
        uuid check_in_id FK
        string question_key
        string answer_text
        float answer_number
    }
    AGENT_CONVERSATIONS {
        uuid id PK
        uuid astronaut_id FK
        string channel
        string status
        string summary
    }
    AGENT_MESSAGES {
        uuid id PK
        uuid conversation_id FK
        string speaker
        string message_text
    }
    HEALTH_ASSESSMENTS {
        uuid id PK
        uuid astronaut_id FK
        timestamptz assessed_at
        string root_cause_summary
        jsonb contributing_data
        string urgency
    }
    TREATMENT_PLANS {
        uuid id PK
        uuid astronaut_id FK
        uuid health_assessment_id FK
        string created_by
        string status
        string rationale
        uuid approved_by_astronaut_id FK
    }
    TREATMENT_PLAN_ITEMS {
        uuid id PK
        uuid treatment_plan_id FK
        uuid medication_id FK
        string action_type
        string description
        string status
    }
    CONDITION_EVENTS {
        uuid id PK
        uuid astronaut_id FK
        string condition_key
        string severity
        string status
        string summary
    }
    DECISIONS {
        uuid id PK
        uuid astronaut_id FK
        uuid condition_event_id FK
        uuid rule_id FK
        uuid escalated_to_astronaut_id FK
        string decision_type
        string outcome
        string rationale
    }
    CREW_ALERTS {
        uuid id PK
        uuid condition_event_id FK
        uuid medication_event_id FK
        uuid recipient_id FK
        string status
        string action_instructions
    }
    MEDICATIONS {
        uuid id PK
        string name UK
        string route
        string stock_unit
        boolean watch_injectable
    }
    MEDICATION_INVENTORY {
        uuid id PK
        uuid mission_id FK
        uuid medication_id FK
        string lot_code
        decimal quantity_on_hand
        date expires_on
    }
    MEDICATION_EVENTS {
        uuid id PK
        uuid astronaut_id FK
        uuid medication_id FK
        uuid condition_event_id FK
        uuid decision_id FK
        decimal quantity
        string quantity_unit
        string status
        timestamptz cancel_until
    }
    MISSION_REPORTS {
        uuid id PK
        uuid mission_id FK
        uuid astronaut_id FK
        string report_type
        string status
        timestamptz sent_at
        timestamptz arrives_at
        timestamptz reply_due_at
    }
    MISSION_COMMAND_REPLIES {
        uuid id PK
        uuid report_id FK
        timestamptz received_at
        string sender
        string message
    }
    LAB_RESULTS {
        uuid id PK
        uuid astronaut_id FK
        uuid entered_by_astronaut_id FK
        string panel_name
        string analyte
        float value
        string unit
    }

    MISSIONS ||--o{ ASTRONAUTS : crews
    ASTRONAUTS ||--|| ACCOUNTS : authenticates
    ASTRONAUTS ||--o{ SESSIONS : signs_in
    MISSIONS ||--o{ COMMAND_HANDOVERS : records
    ASTRONAUTS ||--o{ COMMAND_HANDOVERS : transfers
    MISSIONS ||--o{ RULE_SETS : configures
    RULE_SETS ||--o{ RULES : contains
    ASTRONAUTS ||--o{ VITAL_SAMPLES : records
    ASTRONAUTS ||--o{ SLEEP_SESSIONS : records
    ASTRONAUTS ||--o{ CHECK_INS : completes
    CHECK_INS ||--o{ CHECK_IN_ANSWERS : includes
    ASTRONAUTS ||--o{ AGENT_CONVERSATIONS : starts
    AGENT_CONVERSATIONS ||--o{ AGENT_MESSAGES : contains
    ASTRONAUTS ||--o{ HEALTH_ASSESSMENTS : assessed
    HEALTH_ASSESSMENTS ||--o{ TREATMENT_PLANS : informs
    ASTRONAUTS ||--o{ TREATMENT_PLANS : receives
    TREATMENT_PLANS ||--o{ TREATMENT_PLAN_ITEMS : contains
    ASTRONAUTS ||--o{ CONDITION_EVENTS : experiences
    CONDITION_EVENTS ||--o{ DECISIONS : informs
    RULES ||--o{ DECISIONS : constrains
    CONDITION_EVENTS ||--o{ CREW_ALERTS : triggers
    ASTRONAUTS ||--o{ CREW_ALERTS : receives
    MISSIONS ||--o{ MEDICATION_INVENTORY : stocks
    MEDICATIONS ||--o{ MEDICATION_INVENTORY : tracked
    ASTRONAUTS ||--o{ MEDICATION_EVENTS : receives
    MEDICATIONS ||--o{ MEDICATION_EVENTS : records
    DECISIONS ||--o{ MEDICATION_EVENTS : authorizes
    MEDICATION_EVENTS o|--o{ CREW_ALERTS : informs
    MISSIONS ||--o{ MISSION_REPORTS : queues
    MISSION_REPORTS ||--o{ MISSION_COMMAND_REPLIES : receives
    ASTRONAUTS ||--o{ LAB_RESULTS : has
